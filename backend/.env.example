# Server Port
PORT=5000

# Supabase Credentials (from your Supabase project settings -> API)
SUPABASE_URL=
SUPABASE_KEY=

# AI Provider API Keys (Notice Summarization & Structured Extraction)
# Default recommended provider: Google Gemini (obtain at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative supported provider: xAI Grok (obtain at https://console.x.ai/)
GROK_API_KEY=your_grok_api_key_here
