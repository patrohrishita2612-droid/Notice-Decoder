# ==============================================================================
# Notice-Decoder Frontend Environment Variables
# ==============================================================================

# Backend API Base URL
# In production, this points to your deployed backend on Render:
VITE_API_BASE_URL=https://notice-decoder.onrender.com

# For local development against a local backend, uncomment:
# VITE_API_BASE_URL=http://localhost:5000

# Optional: Enable demo login credentials in production (defaults to false)
# VITE_ALLOW_DEMO_LOGINS=false
